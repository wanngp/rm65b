<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="rm65b_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <light name="key_light" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 3</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 3</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.80 0.82 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="evidence_camera">
      <static>true</static>
      <pose>1.4 -1.2 0.85 0 0.42 2.36</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <topic>/rm65b/evidence_camera/image</topic>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.02</near>
              <far>20</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
