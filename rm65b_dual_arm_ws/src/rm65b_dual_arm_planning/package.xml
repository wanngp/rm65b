<?xml version="1.0"?>
<package format="3">
  <name>rm65b_dual_arm_planning</name>
  <version>0.1.0</version>
  <description>Dual-arm planning and Harmonic FK playback for RM65-B acceptance runs.</description>
  <maintainer email="lab@example.com">RM65-B Lab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rm_ros_interfaces</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
