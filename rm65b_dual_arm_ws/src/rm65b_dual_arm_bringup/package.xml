<?xml version="1.0"?>
<package format="3">
  <name>rm65b_dual_arm_bringup</name>
  <version>0.1.0</version>
  <description>Launch and parameter package for RM65-B dual-arm experiments.</description>
  <maintainer email="lab@example.com">RM65-B Lab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>rm65b_gripper_control</exec_depend>
  <exec_depend>rm65b_safety</exec_depend>
  <exec_depend>rm65b_vision_guidance</exec_depend>
  <exec_depend>rm65b_dual_arm_planning</exec_depend>
  <exec_depend>rm65b_weaving_primitives</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
